# Copy this file to `.env.local` and fill in the values. `.env.local` is gitignored.
#
# Generate a secret with:  npx auth secret

# Public origin of the deployment, no trailing slash. Auth.js uses it to build
# callback URLs, which must match the deployment exactly.
# Local:  http://localhost:3000
# Vercel: https://<your-project>.vercel.app
AUTH_URL=http://localhost:3000

# MongoDB connection string. The database name MUST be included in the path.
# Local:  mongodb://127.0.0.1:27017/blood_donation
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/blood_donation
MONGODB_URI=

# Secret used to encrypt session tokens. Required in production.
AUTH_SECRET=

# --- Cloudinary (profile photos) -------------------------------------------
# All three are required to enable uploads. The API secret is only ever read on
# the server; it must never be exposed to the browser or committed.
# Without them the profile form hides its upload control and falls back to
# initials.
# Find these in Cloudinary console > Settings > API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=